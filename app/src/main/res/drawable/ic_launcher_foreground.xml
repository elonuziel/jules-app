<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer background glow ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26"
        android:strokeColor="#27213C"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Emerald to Jules purple gradient outer arc ring -->
    <path
        android:pathData="M34,35 A28,28 0 1,0 74,35"
        android:strokeWidth="6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="35"
                android:endX="74"
                android:endY="75"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#7C3AED" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center circular core -->
    <path
        android:pathData="M54,42 A12,12 0 1,1 53.9,42"
        android:fillColor="#7C3AED" />

    <path
        android:pathData="M54,46 A8,8 0 1,1 53.9,46"
        android:fillColor="#A855F7" />

    <!-- Clock hands pointing at 10 past 10 -->
    <path
        android:pathData="M54,54 L54,45"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,54 L61,61"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Center dot -->
    <path
        android:pathData="M54,53 A1.5,1.5 0 1,1 53.9,53"
        android:fillColor="#FFFFFF" />
</vector>

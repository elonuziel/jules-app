<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Inner circular container disc -->
    <path
        android:pathData="M54,20 A34,34 0 1,1 53.99,20 Z"
        android:fillColor="#152238" />

    <!-- Outer subtle track under the arc -->
    <path
        android:pathData="M54,27 A27,27 0 1,0 73.1,73.1"
        android:strokeColor="#1C2B46"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Jules async progress arc: Blue to Emerald/Teal gradient -->
    <path
        android:pathData="M54,27 A27,27 0 1,0 73.1,73.1"
        android:strokeWidth="6.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="27"
                android:endX="74"
                android:endY="74"
                android:type="linear">
                <item android:color="#4D93F8" android:offset="0.0" />
                <item android:color="#37AFBC" android:offset="0.55" />
                <item android:color="#26B3A3" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center circular core: Outer blue circle -->
    <path
        android:pathData="M54,42.5 A11.5,11.5 0 1,1 53.99,42.5 Z"
        android:fillColor="#3B82F6" />

    <!-- Center circular core: Inner light blue circle -->
    <path
        android:pathData="M54,48.5 A5.5,5.5 0 1,1 53.99,48.5 Z"
        android:fillColor="#60A5FA" />

    <!-- Clock minute hand pointing up (12:00) -->
    <path
        android:pathData="M54,54 L54,42.2"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Clock hour hand pointing to ~4:30 -->
    <path
        android:pathData="M54,54 L60.8,60.8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Center pivot dot -->
    <path
        android:pathData="M54,52.7 A1.3,1.3 0 1,1 53.99,52.7 Z"
        android:fillColor="#FFFFFF" />
</vector>
